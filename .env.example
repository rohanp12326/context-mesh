# ============================================================
# ContextMesh Environment Configuration
# ============================================================

# LLM Provider Configuration (ZAI GLM API)
ZAI_API_KEY=your_zai_api_key_here
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZAI_MODEL=glm-4.5-air
# Alternative options: glm-4-plus, glm-4.5, glm-4-flash, glm-4-air, glm-4-long, glm-4


# Storage & Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/context_mesh

# Connector Modes (mock | live)
# "mock" uses offline synthetic datasets (Project Atlas)
# "live" queries real Jira, Slack, and Gmail APIs
CONNECTOR_MODE=mock

# Live Jira Credentials (optional if CONNECTOR_MODE=live)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=you@company.com
JIRA_API_TOKEN=your_jira_api_token

# Live Slack Credentials & Remote MCP (optional if CONNECTOR_MODE=live)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_USER_TOKEN=xoxp-your-slack-user-token
SLACK_MCP_ENDPOINT=https://mcp.slack.com/mcp
SLACK_MCP_TOKEN=xoxb-your-slack-mcp-token

# Live Gmail Credentials (optional if CONNECTOR_MODE=live)
GMAIL_CREDENTIALS_FILE=secrets/gmail_credentials.json
GMAIL_TOKEN_FILE=secrets/gmail_token.json

# Observability & Tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=context-mesh

# Security & Safety
REDACT_PII_IN_LOGS=true
REQUIRE_APPROVAL_FOR_WRITES=true
MAX_PLAN_STEPS=6
MAX_TOOL_CALLS=10

# Application File Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/context_mesh.log
